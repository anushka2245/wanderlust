<% layout('layouts/boilerplate') %>

<div class="row mt-5 justify-content-center">
    <div class="alert alert-danger col-md-6 text-center" role="alert">
        <svg class="bi flex-shrink-0 me-2" width="32" height="32" role="img" aria-label="Danger:">
            <use xlink:href="#exclamation-triangle-fill"/>
        </svg>
        <h4 class="alert-heading">Error <%= statusCode || 500 %></h4>
        <p><%= message || "Something went wrong!" %></p>
        <hr>
        <a href="/" class="btn btn-outline-light mt-2">Back to Home</a>
    </div>
</div>
